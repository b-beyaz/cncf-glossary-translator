# Authentication Configuration
# Choose ONE of the following authentication methods:

# Option 1: Direct Anthropic API (recommended for most users)
ANTHROPIC_API_KEY=your_api_key_here

# Option 2: Google Cloud Vertex AI (for enterprise users with GCP setup)
# Uncomment and configure these if using Vertex AI:
# ANTHROPIC_VERTEX_PROJECT_ID=your-gcp-project-id
# CLOUD_ML_REGION=us-east5

# Model Configuration
# MODEL_NAME is optional. If not set, defaults are:
#   - Direct API: claude-sonnet-4-20250514
#   - Vertex AI:  claude-sonnet-4-5@20250929
#
# For Direct Anthropic API, use model IDs like:
#   MODEL_NAME=claude-sonnet-4-20250514
#   MODEL_NAME=claude-opus-4-20250514
#   MODEL_NAME=claude-3-5-sonnet-20241022
#
# For Vertex AI, use Vertex model versions like:
#   MODEL_NAME=claude-3-5-sonnet@20240620
#   MODEL_NAME=claude-3-5-sonnet-v2@20241022
#   MODEL_NAME=claude-3-opus@20240229
#   MODEL_NAME=claude-3-haiku@20240307
#
# To find available models in Vertex AI:
# 1. If using Claude Code with Vertex AI, type /model in a Claude conversation
# 2. Visit Google Cloud Console:
#    https://console.cloud.google.com/vertex-ai/model-garden/anthropic
# 3. Or check Anthropic's Vertex AI documentation:
#    https://docs.anthropic.com/en/api/claude-on-vertex-ai
#
# MODEL_NAME=claude-3-5-sonnet@20240620

# Optional Configuration
# GLOSSARY_PATH=glossary.csv
BASE_BRANCH="dev-tr"
REPO_PATH="/your/path/glossary"
OUTPUT_DIR="/your/path/glossary/content/tr"
GITHUB_TOKEN=your_github_token
GITHUB_USER=your_github_user